# ────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ────────────────────────────────────────────────
# MySQL Database
# ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_NAME=support_tickets

# ────────────────────────────────────────────────
# JWT Authentication
# ────────────────────────────────────────────────
# ⚠️  Replace with a strong random secret before deploying!
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
